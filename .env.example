# Resend API Key — maak een gratis account op resend.com
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E-mailadres waarnaar contactformulier- en nieuwsbrief-aanmeldingen worden gestuurd
CONTACT_EMAIL=contact@rijschooldrivemore.nl

# Afzenderadres voor uitgaande mail. Werkt pas nadat het domein rijschooldrivemore.nl
# is geverifieerd op resend.com/domains. Tot die tijd: laat deze variabele leeg/weg —
# de app valt dan automatisch terug op het Resend-testadres (onboarding@resend.dev),
# zodat lokaal testen zonder geverifieerd domein blijft werken.
MAIL_FROM=noreply@rijschooldrivemore.nl

# Basis-URL van de site (gebruikt voor OG-tags)
NEXT_PUBLIC_SITE_URL=https://rijschooldrivemore.nl
